# PartyKit host for real-time synchronization
# In locale punta a localhost:1999 (default di partykit dev)
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# In produzione su Vercel, imposta con l'host generato dal comando `npx partykit deploy`
# Es: NEXT_PUBLIC_PARTYKIT_HOST=operazione-notte-silenziosa.username.partykit.dev
